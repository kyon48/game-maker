{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "id",
    "title",
    "version",
    "formatVersion",
    "tileSize",
    "screen",
    "maps",
    "start",
    "player",
    "plugins",
    "labels",
    "state"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "pattern": "^[a-z][a-z0-9_]*$",
      "type": "string"
    },
    "title": {
      "minLength": 1,
      "type": "string"
    },
    "version": {
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$",
      "type": "string"
    },
    "formatVersion": {
      "minimum": 1,
      "maximum": 9007199254740991,
      "type": "integer"
    },
    "tileSize": {
      "minimum": 1,
      "maximum": 9007199254740991,
      "type": "integer"
    },
    "screen": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "width",
        "height"
      ],
      "properties": {
        "width": {
          "minimum": 1,
          "maximum": 9007199254740991,
          "type": "integer"
        },
        "height": {
          "minimum": 1,
          "maximum": 9007199254740991,
          "type": "integer"
        }
      }
    },
    "maps": {
      "minItems": 1,
      "uniqueItems": true,
      "type": "array",
      "items": {
        "pattern": "^[a-z][a-z0-9_]*$",
        "type": "string"
      }
    },
    "start": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "map",
        "x",
        "y",
        "dir"
      ],
      "properties": {
        "map": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "type": "string"
        },
        "x": {
          "minimum": -9007199254740991,
          "maximum": 9007199254740991,
          "type": "integer"
        },
        "y": {
          "minimum": -9007199254740991,
          "maximum": 9007199254740991,
          "type": "integer"
        },
        "dir": {
          "anyOf": [
            {
              "const": "up",
              "type": "string"
            },
            {
              "const": "down",
              "type": "string"
            },
            {
              "const": "left",
              "type": "string"
            },
            {
              "const": "right",
              "type": "string"
            }
          ]
        }
      }
    },
    "player": {
      "pattern": "^[a-z][a-z0-9_]*$",
      "type": "string"
    },
    "plugins": {
      "uniqueItems": true,
      "type": "array",
      "items": {
        "pattern": "^[a-z][a-z0-9_]*$",
        "type": "string"
      }
    },
    "labels": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "continue",
        "newGame"
      ],
      "properties": {
        "continue": {
          "minLength": 1,
          "type": "string"
        },
        "newGame": {
          "minLength": 1,
          "type": "string"
        }
      }
    },
    "state": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "flags",
        "vars"
      ],
      "properties": {
        "flags": {
          "additionalProperties": false,
          "type": "object",
          "patternProperties": {
            "^[a-z][a-z0-9_]*$": {
              "type": "boolean"
            }
          }
        },
        "vars": {
          "additionalProperties": false,
          "type": "object",
          "patternProperties": {
            "^[a-z][a-z0-9_]*$": {
              "minimum": -9007199254740991,
              "maximum": 9007199254740991,
              "type": "integer"
            }
          }
        }
      }
    }
  }
}
