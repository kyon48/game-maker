{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "font",
    "window",
    "colors",
    "message"
  ],
  "properties": {
    "font": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "family",
        "src",
        "size",
        "lineHeight"
      ],
      "properties": {
        "family": {
          "minLength": 1,
          "type": "string"
        },
        "src": {
          "minLength": 1,
          "type": "string"
        },
        "size": {
          "minimum": 1,
          "maximum": 9007199254740991,
          "type": "integer"
        },
        "lineHeight": {
          "minimum": 1,
          "maximum": 9007199254740991,
          "type": "integer"
        }
      }
    },
    "window": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "slice",
        "padding"
      ],
      "properties": {
        "image": {
          "minLength": 1,
          "type": "string"
        },
        "slice": {
          "minimum": 1,
          "maximum": 9007199254740991,
          "type": "integer"
        },
        "padding": {
          "minimum": 0,
          "maximum": 9007199254740991,
          "type": "integer"
        }
      }
    },
    "colors": {
      "additionalProperties": {
        "type": "string"
      },
      "type": "object",
      "required": [
        "text",
        "speaker",
        "cursor",
        "fade"
      ],
      "properties": {
        "text": {
          "type": "string"
        },
        "speaker": {
          "type": "string"
        },
        "cursor": {
          "type": "string"
        },
        "fade": {
          "type": "string"
        },
        "mapNameText": {
          "type": "string"
        },
        "mapNameBackground": {
          "type": "string"
        }
      }
    },
    "message": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "rows",
        "charsPerTick"
      ],
      "properties": {
        "rows": {
          "minimum": 1,
          "maximum": 9007199254740991,
          "type": "integer"
        },
        "charsPerTick": {
          "minimum": 1,
          "maximum": 9007199254740991,
          "type": "integer"
        },
        "voiceGap": {
          "minimum": 0,
          "maximum": 10,
          "type": "number"
        }
      }
    }
  }
}
