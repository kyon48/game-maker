{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "events"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "events": {
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "x",
          "y",
          "pages"
        ],
        "properties": {
          "id": {
            "pattern": "^[a-z][a-z0-9_]*$",
            "type": "string"
          },
          "x": {
            "minimum": -9007199254740991,
            "maximum": 9007199254740991,
            "type": "integer"
          },
          "y": {
            "minimum": -9007199254740991,
            "maximum": 9007199254740991,
            "type": "integer"
          },
          "pages": {
            "minItems": 1,
            "type": "array",
            "items": {
              "additionalProperties": false,
              "type": "object",
              "required": [
                "trigger"
              ],
              "properties": {
                "character": {
                  "pattern": "^[a-z][a-z0-9_]*$",
                  "type": "string"
                },
                "dir": {
                  "anyOf": [
                    {
                      "const": "up",
                      "type": "string"
                    },
                    {
                      "const": "down",
                      "type": "string"
                    },
                    {
                      "const": "left",
                      "type": "string"
                    },
                    {
                      "const": "right",
                      "type": "string"
                    }
                  ]
                },
                "through": {
                  "type": "boolean"
                },
                "when": {
                  "$ref": "#/$defs/Condition"
                },
                "trigger": {
                  "anyOf": [
                    {
                      "const": "action",
                      "type": "string"
                    },
                    {
                      "const": "touch",
                      "type": "string"
                    },
                    {
                      "const": "auto",
                      "type": "string"
                    },
                    {
                      "const": "parallel",
                      "type": "string"
                    },
                    {
                      "const": "none",
                      "type": "string"
                    }
                  ]
                },
                "commands": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/Command"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "Command": {
      "anyOf": [
        {
          "additionalProperties": false,
          "type": "object",
          "required": [
            "map",
            "cmd"
          ],
          "properties": {
            "map": {
              "pattern": "^[a-z][a-z0-9_]*$",
              "type": "string"
            },
            "marker": {
              "pattern": "^[a-z][a-z0-9_]*$",
              "type": "string"
            },
            "x": {
              "type": "integer"
            },
            "y": {
              "type": "integer"
            },
            "dir": {
              "anyOf": [
                {
                  "const": "up",
                  "type": "string"
                },
                {
                  "const": "down",
                  "type": "string"
                },
                {
                  "const": "left",
                  "type": "string"
                },
                {
                  "const": "right",
                  "type": "string"
                }
              ]
            },
            "fade": {
              "type": "boolean"
            },
            "cmd": {
              "const": "transfer",
              "type": "string"
            }
          }
        },
        {
          "additionalProperties": false,
          "type": "object",
          "required": [
            "target",
            "visible",
            "cmd"
          ],
          "properties": {
            "target": {
              "pattern": "^[a-z][a-z0-9_]*$",
              "type": "string"
            },
            "visible": {
              "type": "boolean"
            },
            "cmd": {
              "const": "show_character",
              "type": "string"
            }
          }
        },
        {
          "additionalProperties": false,
          "type": "object",
          "properties": {
            "power": {
              "minimum": 0,
              "type": "number"
            },
            "frames": {
              "minimum": 1,
              "maximum": 9007199254740991,
              "type": "integer"
            },
            "wait": {
              "type": "boolean"
            },
            "cmd": {
              "const": "shake",
              "type": "string"
            }
          },
          "required": [
            "cmd"
          ]
        },
        {
          "additionalProperties": false,
          "type": "object",
          "required": [
            "to",
            "cmd"
          ],
          "properties": {
            "to": {
              "anyOf": [
                {
                  "const": "black",
                  "type": "string"
                },
                {
                  "const": "clear",
                  "type": "string"
                }
              ]
            },
            "frames": {
              "minimum": 1,
              "maximum": 9007199254740991,
              "type": "integer"
            },
            "wait": {
              "type": "boolean"
            },
            "cmd": {
              "const": "fade",
              "type": "string"
            }
          }
        },
        {
          "additionalProperties": false,
          "type": "object",
          "required": [
            "target",
            "route",
            "cmd"
          ],
          "properties": {
            "target": {
              "pattern": "^[a-z][a-z0-9_]*$",
              "type": "string"
            },
            "route": {
              "type": "array",
              "items": {
                "pattern": "^(up|down|left|right|face:(up|down|left|right)|wait:[1-9][0-9]*)$",
                "type": "string"
              }
            },
            "wait": {
              "type": "boolean"
            },
            "cmd": {
              "const": "move",
              "type": "string"
            }
          }
        },
        {
          "additionalProperties": false,
          "type": "object",
          "required": [
            "common",
            "cmd"
          ],
          "properties": {
            "common": {
              "pattern": "^[a-z][a-z0-9_]*$",
              "type": "string"
            },
            "cmd": {
              "const": "call",
              "type": "string"
            }
          }
        },
        {
          "additionalProperties": false,
          "type": "object",
          "required": [
            "text",
            "cmd"
          ],
          "properties": {
            "text": {
              "minLength": 1,
              "pattern": "^[^\\u0000-\\u0009\\u000b-\\u001f\\u007f]*$",
              "type": "string"
            },
            "speaker": {
              "type": "string"
            },
            "cmd": {
              "const": "text",
              "type": "string"
            }
          }
        },
        {
          "additionalProperties": false,
          "type": "object",
          "required": [
            "frames",
            "cmd"
          ],
          "properties": {
            "frames": {
              "minimum": 1,
              "maximum": 9007199254740991,
              "type": "integer"
            },
            "cmd": {
              "const": "wait",
              "type": "string"
            }
          }
        },
        {
          "additionalProperties": false,
          "type": "object",
          "properties": {
            "cmd": {
              "const": "stop",
              "type": "string"
            }
          },
          "required": [
            "cmd"
          ]
        },
        {
          "additionalProperties": false,
          "type": "object",
          "required": [
            "flag",
            "value",
            "cmd"
          ],
          "properties": {
            "flag": {
              "pattern": "^[a-z][a-z0-9_]*$",
              "type": "string"
            },
            "value": {
              "type": "boolean"
            },
            "cmd": {
              "const": "set_flag",
              "type": "string"
            }
          }
        },
        {
          "additionalProperties": false,
          "type": "object",
          "required": [
            "var",
            "value",
            "cmd"
          ],
          "properties": {
            "var": {
              "pattern": "^[a-z][a-z0-9_]*$",
              "type": "string"
            },
            "op": {
              "anyOf": [
                {
                  "const": "set",
                  "type": "string"
                },
                {
                  "const": "add",
                  "type": "string"
                },
                {
                  "const": "sub",
                  "type": "string"
                }
              ]
            },
            "value": {
              "minimum": -9007199254740991,
              "maximum": 9007199254740991,
              "type": "integer"
            },
            "cmd": {
              "const": "set_var",
              "type": "string"
            }
          }
        },
        {
          "additionalProperties": false,
          "type": "object",
          "required": [
            "name",
            "value",
            "cmd"
          ],
          "properties": {
            "name": {
              "pattern": "^[a-z][a-z0-9_]*$",
              "type": "string"
            },
            "value": {
              "type": "boolean"
            },
            "cmd": {
              "const": "set_self_flag",
              "type": "string"
            }
          }
        },
        {
          "additionalProperties": false,
          "type": "object",
          "required": [
            "target",
            "dir",
            "cmd"
          ],
          "properties": {
            "target": {
              "pattern": "^[a-z][a-z0-9_]*$",
              "type": "string"
            },
            "dir": {
              "anyOf": [
                {
                  "const": "up",
                  "type": "string"
                },
                {
                  "const": "down",
                  "type": "string"
                },
                {
                  "const": "left",
                  "type": "string"
                },
                {
                  "const": "right",
                  "type": "string"
                },
                {
                  "const": "player",
                  "type": "string"
                }
              ]
            },
            "cmd": {
              "const": "face",
              "type": "string"
            }
          }
        },
        {
          "additionalProperties": false,
          "type": "object",
          "required": [
            "cond",
            "then",
            "cmd"
          ],
          "properties": {
            "cond": {
              "$ref": "#/$defs/Condition"
            },
            "then": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Command"
              }
            },
            "else": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Command"
              }
            },
            "cmd": {
              "const": "if",
              "type": "string"
            }
          }
        },
        {
          "additionalProperties": false,
          "type": "object",
          "required": [
            "options",
            "cmd"
          ],
          "properties": {
            "prompt": {
              "type": "string"
            },
            "options": {
              "minItems": 1,
              "maxItems": 6,
              "type": "array",
              "items": {
                "additionalProperties": false,
                "type": "object",
                "required": [
                  "label",
                  "commands"
                ],
                "properties": {
                  "label": {
                    "minLength": 1,
                    "pattern": "^[^\\u0000-\\u0009\\u000b-\\u001f\\u007f]*$",
                    "type": "string"
                  },
                  "when": {
                    "$ref": "#/$defs/Condition"
                  },
                  "commands": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/Command"
                    }
                  }
                }
              }
            },
            "cancel": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "minimum": 0,
                  "type": "integer"
                }
              ]
            },
            "cmd": {
              "const": "choice",
              "type": "string"
            }
          }
        },
        {
          "additionalProperties": false,
          "type": "object",
          "properties": {
            "cmd": {
              "const": "save",
              "type": "string"
            }
          },
          "required": [
            "cmd"
          ]
        }
      ]
    },
    "Condition": {
      "anyOf": [
        {
          "additionalProperties": false,
          "type": "object",
          "required": [
            "flag",
            "is"
          ],
          "properties": {
            "flag": {
              "pattern": "^[a-z][a-z0-9_]*$",
              "type": "string"
            },
            "is": {
              "type": "boolean"
            }
          }
        },
        {
          "additionalProperties": false,
          "type": "object",
          "required": [
            "var",
            "op",
            "value"
          ],
          "properties": {
            "var": {
              "pattern": "^[a-z][a-z0-9_]*$",
              "type": "string"
            },
            "op": {
              "anyOf": [
                {
                  "const": "==",
                  "type": "string"
                },
                {
                  "const": "!=",
                  "type": "string"
                },
                {
                  "const": ">",
                  "type": "string"
                },
                {
                  "const": ">=",
                  "type": "string"
                },
                {
                  "const": "<",
                  "type": "string"
                },
                {
                  "const": "<=",
                  "type": "string"
                }
              ]
            },
            "value": {
              "minimum": -9007199254740991,
              "maximum": 9007199254740991,
              "type": "integer"
            }
          }
        },
        {
          "additionalProperties": false,
          "type": "object",
          "required": [
            "self",
            "is"
          ],
          "properties": {
            "self": {
              "pattern": "^[a-z][a-z0-9_]*$",
              "type": "string"
            },
            "is": {
              "type": "boolean"
            }
          }
        },
        {
          "additionalProperties": false,
          "type": "object",
          "required": [
            "all"
          ],
          "properties": {
            "all": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Condition"
              }
            }
          }
        },
        {
          "additionalProperties": false,
          "type": "object",
          "required": [
            "any"
          ],
          "properties": {
            "any": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Condition"
              }
            }
          }
        },
        {
          "additionalProperties": false,
          "type": "object",
          "required": [
            "not"
          ],
          "properties": {
            "not": {
              "$ref": "#/$defs/Condition"
            }
          }
        },
        {
          "additionalProperties": false,
          "type": "object",
          "required": [
            "plugin",
            "args"
          ],
          "properties": {
            "plugin": {
              "pattern": "^x_[a-z0-9_]+$",
              "type": "string"
            },
            "args": {
              "type": "object",
              "patternProperties": {
                "^(.*)$": {}
              }
            }
          }
        }
      ]
    }
  }
}
