{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "type": "object",
  "patternProperties": {
    "^[a-z][a-z0-9_]*$": {
      "additionalProperties": false,
      "type": "object",
      "patternProperties": {
        "^[a-z][a-z0-9_]*$": {
          "pattern": "^assets/portraits/[^\\\\]+\\.png$",
          "type": "string"
        }
      }
    }
  }
}
