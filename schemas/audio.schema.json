{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "type": "object",
  "patternProperties": {
    "^[a-z][a-z0-9_]*$": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "file"
      ],
      "properties": {
        "file": {
          "minLength": 1,
          "type": "string"
        },
        "volume": {
          "minimum": 0,
          "maximum": 1,
          "type": "number"
        },
        "loop": {
          "type": "boolean"
        }
      }
    }
  }
}
