{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "node"
    ],
    "baseUrl": ".",
    "paths": {
      "@engine/api": [
        "engine/api/index.ts"
      ]
    }
  },
  "include": [
    "engine/**/*.ts",
    "tools/**/*.ts",
    "tests/**/*.ts",
    "packs/*/plugins/**/*.ts",
    "vite.config.ts"
  ]
}
