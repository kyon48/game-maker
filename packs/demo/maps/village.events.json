                      "speaker": "촌장",
                      "text": "북쪽 숲은 조심하게."
                    }
                  ]
                },
                {
                  "label": "…",
                  "commands": [
                    {
                      "cmd": "if",
                      "cond": {
                        "not": {
                          "flag": "met_elder",
                          "is": true
                        }
                      },
                      "then": [
                        {
                          "cmd": "text",
                          "speaker": "촌장",
                          "text": "말이 없어도 괜찮네."
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "cmd": "set_flag",
