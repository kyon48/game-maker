            },
            {
              "cmd": "set_var",
              "var": "gold",
              "op": "add",
              "value": 10
            },
            {
              "cmd": "set_self_flag",
              "name": "opened",
              "value": true
            },
            {
              "cmd": "wait",
              "frames": 1
            },
            {
              "cmd": "if",
              "cond": {
                "self": "opened",
                "is": true
              },
              "then": [
                {
                  "cmd": "stop"
                }
              ]
            },
            {
              "cmd": "set_var",
              "var": "gold",
              "value": 999
            }
          ]
        },
        {
          "when": {
            "self": "opened",
            "is": true
          },
          "character": "chest_open",
          "trigger": "none"
        }
      ]
    }
