              "value": true
            }
          ]
        },
        {
          "when": {
            "flag": "met_elder",
            "is": true
          },
          "character": "elder",
          "dir": "left",
          "trigger": "action",
          "commands": [
            {
              "cmd": "text",
              "speaker": "촌장",
              "text": "또 왔나. 마을을 천천히 둘러보게."
            }
          ]
        }
      ]
    },
    {
      "id": "flower",
      "x": 13,
      "y": 11,
      "pages": [
        {
          "character": "flower",
