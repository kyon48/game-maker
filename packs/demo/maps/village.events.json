        }
      ]
    },
    {
      "id": "chest",
      "x": 13,
      "y": 10,
      "pages": [
        {
          "when": {
            "self": "opened",
            "is": false
          },
          "character": "chest_closed",
          "trigger": "action",
          "commands": [
            {
              "cmd": "text",
